# Supabase PostgreSQL Connection Strings
# Transaction connection pooler (Port 6543) for Next.js runtime:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Port 5432) for Prisma CLI migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security & Authentication (Required: Generate a high-entropy secret in production)
JWT_SECRET="learnpath-ai-super-secret-production-jwt-key-minimum-32-chars"

# AI Learning Coach Gateway
AI_COACH_API_KEY=""
AI_COACH_MODEL="gemini-1.5-flash"

# Platform Branding
NEXT_PUBLIC_APP_NAME="LearnPath AI"

# Optional Supabase Client SDK variables (if client-side Supabase features are activated)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

PORT=3000
